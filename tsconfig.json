{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "lib": ["ESNext"],
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        

        "rootDir": "src",
        "outDir": "dist",
        
        "types": ["node"], // utilizar os tipos do node

        "noUnusedLocals": true, // não permitir variáveis não utilizadas
        "noUnusedParameters": true, // não permitir parâmetros não utilizados
        "noEmitOnError": true,

        "verbatimModuleSyntax": true
    },

    "include": ["src"],
    "exclude": ["node_modules"]
}